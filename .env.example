# Optional overrides for compose.yaml. Copy to .env and edit before the first start.
# Every value has a working default, so this file is not needed to try ShopBite.

# Administration login (http://localhost:8000/admin, user "admin")
ADMIN_PASSWORD=shopbite

# Shop name in the storefront
SHOP_NAME=ShopBite Demo

# 0 = create the sales channel without the demo menu (fresh install only)
SEED_DEMO_MENU=1

# Shopware secrets, generate with: openssl rand -hex 32
#APP_SECRET=
#INSTANCE_ID=

# Images, e.g. a dated tag (ghcr.io/shopbite-de/shopbite-shopware:20261005) to stay on one version
#SHOPWARE_IMAGE=ghcr.io/shopbite-de/shopbite-shopware:latest
#STOREFRONT_IMAGE=ghcr.io/shopbite-de/shopbite-storefront:latest
